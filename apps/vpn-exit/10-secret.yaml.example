# Credentials for the proton-exit Tailscale exit node (20-deployment.yaml).
# Copy to 10-secret.yaml (gitignored) and fill in the real values.
apiVersion: v1
kind: Secret
metadata:
  name: vpn-credentials-proton-exit
  namespace: vpn-exit
type: Opaque
stringData:
  # A third ProtonVPN WireGuard config (account > Downloads > WireGuard, platform
  # Linux, NAT type "Moderate" so Tailscale can connect directly more often).
  # Do not reuse the qBittorrent or Prowlarr config: two tunnels sharing one key
  # fight each other.
  VPN_SERVICE_PROVIDER: "protonvpn"
  WIREGUARD_PRIVATE_KEY: "CHANGE_ME"          # [Interface] PrivateKey
  WIREGUARD_ADDRESSES: "10.2.0.2/32"          # [Interface] Address, IPv4 part only
  SERVER_COUNTRIES: "United States"
---
apiVersion: v1
kind: Secret
metadata:
  name: tailscale-auth-proton-exit
  namespace: vpn-exit
type: Opaque
stringData:
  # Admin console > Settings > Keys > Generate auth key: reusable off,
  # pre-approved on, tag tag:exit-proton. Only used for the first login; the
  # node's state lives in /mnt/config/proton-exit after that.
  TS_AUTHKEY: "tskey-auth-CHANGE_ME"
