# API keys for the Homepage widgets in 20-homepage.yaml. Copy to 10-secret.yaml
# (gitignored) and fill in the values. Homepage substitutes each HOMEPAGE_VAR_*
# into services.yaml as {{HOMEPAGE_VAR_*}}.
#   Radarr / Sonarr / Prowlarr: <ApiKey> in /mnt/config/<app>/config.xml
#   Jellyfin: Dashboard > API Keys
#   Pi-hole: the admin password (or an app password from Settings > Web interface / API)
# The live values are in secrets/CREDENTIALS.txt (*_API and PIHOLE_PW).
apiVersion: v1
kind: Secret
metadata:
  name: homepage-widgets
  namespace: dashboard
type: Opaque
stringData:
  HOMEPAGE_VAR_RADARR_KEY: "CHANGE_ME"
  HOMEPAGE_VAR_SONARR_KEY: "CHANGE_ME"
  HOMEPAGE_VAR_PROWLARR_KEY: "CHANGE_ME"
  HOMEPAGE_VAR_JELLYFIN_KEY: "CHANGE_ME"
  HOMEPAGE_VAR_PIHOLE_KEY: "CHANGE_ME"
  # The tailnet's DNS name (admin console > DNS), e.g. tail1234.ts.net. Builds
  # the https://<app>.<tailnet> links; kept out of git like the keys above.
  HOMEPAGE_VAR_TAILNET: "CHANGE_ME"
