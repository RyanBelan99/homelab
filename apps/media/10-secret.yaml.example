# VPN credentials for the gluetun sidecar in 21-qbittorrent.yaml.
# Copy to 10-secret.yaml (gitignored) and fill in the values from your VPN
# provider's WireGuard config file. Provider names and per-provider settings:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
apiVersion: v1
kind: Secret
metadata:
  name: vpn-credentials-qbittorrent
  namespace: media
type: Opaque
stringData:
  VPN_SERVICE_PROVIDER: "protonvpn"           # e.g. protonvpn, airvpn, private internet access
  WIREGUARD_PRIVATE_KEY: "CHANGE_ME"          # [Interface] PrivateKey
  WIREGUARD_ADDRESSES: "10.2.0.2/32"          # [Interface] Address, IPv4 part only (the cluster is IPv4-only)
  SERVER_COUNTRIES: "United States"
  VPN_PORT_FORWARDING: "on"                   # only for providers that support it
  PORT_FORWARD_ONLY: "on"                     # ProtonVPN: only pick P2P servers that can forward a port
---
# Second tunnel for the gluetun sidecar in 24-prowlarr.yaml. Use a separate
# WireGuard config from the provider: two tunnels sharing one key fight each other.
# Prowlarr only makes outgoing requests, so no port forwarding is needed.
apiVersion: v1
kind: Secret
metadata:
  name: vpn-credentials-prowlarr
  namespace: media
type: Opaque
stringData:
  VPN_SERVICE_PROVIDER: "protonvpn"
  WIREGUARD_PRIVATE_KEY: "CHANGE_ME"          # [Interface] PrivateKey of the second config
  WIREGUARD_ADDRESSES: "10.2.0.2/32"          # [Interface] Address
  SERVER_COUNTRIES: "United States"
---
# Database password for Dispatcharr's PostgreSQL (27-dispatcharr.yaml). Only
# Dispatcharr uses it; any long random string works, e.g. `openssl rand -hex 24`.
# Changing it after the first start means changing it inside PostgreSQL too.
apiVersion: v1
kind: Secret
metadata:
  name: dispatcharr-db
  namespace: media
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME"
---
# API key the livetv-playlists job (28-livetv-playlists.yaml) uses to keep
# Dispatcharr's channels in sync. Generate it in Dispatcharr: Users, edit your
# admin user, API Key.
apiVersion: v1
kind: Secret
metadata:
  name: dispatcharr-api
  namespace: media
type: Opaque
stringData:
  DISPATCHARR_API_KEY: "CHANGE_ME"
