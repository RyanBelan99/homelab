// Tailnet access policy. Paste into the admin console (Access controls) to apply.
// Roles come from the console's Users page: admins are autogroup:admin, everyone else a member.
{
	"hosts": {
		"pihole-dns": "192.168.0.34",
	},

	"tagOwners": {
		"tag:homelab":      ["autogroup:admin"],
		"tag:exit-proton":  ["autogroup:admin"],
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["tag:k8s-operator"],
	},

	"autoApprovers": {
		"routes":   {"192.168.0.0/24": ["tag:homelab"]},
		"exitNode": ["tag:homelab", "tag:exit-proton"],
		// One per app route; each is also defined on the console's Services page (tcp:443).
		"services": {
			"svc:jellyfin":    ["tag:homelab"],
			"svc:seerr":       ["tag:homelab"],
			"svc:home":        ["tag:homelab"],
			"svc:radarr":      ["tag:homelab"],
			"svc:sonarr":      ["tag:homelab"],
			"svc:prowlarr":    ["tag:homelab"],
			"svc:qbit":        ["tag:homelab"],
			"svc:pihole":      ["tag:homelab"],
			"svc:dispatcharr": ["tag:homelab"],
		},
	},

	"grants": [
		// Members: own devices, Jellyfin and Seerr, Pi-hole DNS, and the ProtonVPN exit node.
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},
		{"src": ["autogroup:member"], "dst": ["svc:jellyfin", "svc:seerr"], "ip": ["tcp:443"]},
		{"src": ["autogroup:member"], "dst": ["pihole-dns"], "ip": ["tcp:53", "udp:53"]},
		{"src": ["autogroup:member"], "dst": ["autogroup:internet"], "ip": ["*"], "via": ["tag:exit-proton"]},

		// Admins: every app.
		{
			"src": ["autogroup:admin"],
			"dst": ["svc:home", "svc:radarr", "svc:sonarr", "svc:prowlarr", "svc:qbit", "svc:pihole", "svc:dispatcharr"],
			"ip":  ["tcp:443"],
		},
		// Admins: kubectl through the operator's API proxy, impersonated as cluster-admin.
		{
			"src": ["autogroup:admin"],
			"dst": ["tag:k8s-operator"],
			"ip":  ["tcp:443"],
			"app": {
				"tailscale.com/cap/kubernetes": [{"impersonate": {"groups": ["system:masters"]}}],
			},
		},
		// Admins: SSH, SMB, and the k3s API directly (break-glass).
		{"src": ["autogroup:admin"], "dst": ["tag:homelab"], "ip": ["tcp:22", "tcp:6443", "tcp:445"]},
		// Admins: either exit node.
		{"src": ["autogroup:admin"], "dst": ["autogroup:internet"], "ip": ["*"]},
	],
}
